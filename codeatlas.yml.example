embeddings:
  provider: sentence_transformers
  model: jinaai/jina-embeddings-v2-base-code
  dimensions: 768
  batch_size: 32

llm:
  enabled: true
  provider: lmstudio
  model: qwen3-coder-30b-a3b-instruct
  temperature: 0.1
  max_tokens: 512
  base_url: http://localhost:1234/v1
  api_key: lm-studio
